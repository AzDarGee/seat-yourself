<li class='list-group-item'>
  <div>
    <span class='title-design-first-letter'><%= restaurant.name.chars.first %></span>
      <span class='title-design right'>
      <% rest_of_name = '' %>
      <% restaurant.name.chars[1..-1].each do |letter| %>
        <% rest_of_name += letter %>
      <% end %>
      <%= rest_of_name  %>

    </span>

    <span class='address-design'> => <%= restaurant.address %></span>

    <hr>
  </div>

  <div class="center">Description: <%= restaurant.description %></div>
  <div class='center'>Capacity: <%= restaurant.capacity %></div>
  <% if current_user %>
    <div class='center'><%= link_to 'Edit', edit_restaurant_path(restaurant) %> | <%= link_to 'Delete',restaurant, method: :delete, data: { confirm: 'Are you sure?' } %></div>
  <% end %>
</li>