<div class='row'>
  <div class='col-md-12'>
    <div class='form-group'>
        <%= form_tag restaurants_path, method: :get, authentication: false, id: 'search-form' do %>
          <%= text_field_tag :search, params[:search], placeholder: 'Find a place to eat ...', class: 'form-control flat input-hg', id: 'search-input' %>
          <%= submit_tag "Search", name: nil, type: 'hidden' %>
        <% end %>
    </div>

    <ul class='list-group' id='restaurants'>
      <%= render @restaurants %>
    </ul>
  </div>

</div>