<div class='row'>
  <div class='col-md-12'>
    <div class='form-group'>

        <%= form_tag restaurants_path, method: :get, authentication: false, id: 'search-form' do %>
          <%= text_field_tag :search, params[:search], placeholder: 'Find a place to eat ...', class: 'form-control flat input-hg', id: 'search-input' %>
          <%= submit_tag "Search", name: nil, type: 'hidden' %>
        <% end %>
    </div>


    <ul class='list-group'>

      <% @restaurants.each do |r| %>
      	<li class='list-group-item'>
          <div>
            <span class='title-design-first-letter'><%= r.name.chars.first %></span>
              <span class='title-design right'>
              <% rest_of_name = '' %>
              <% r.name.chars[1..-1].each do |letter| %>
                <% rest_of_name += letter %>
              <% end %>
              <%= rest_of_name  %>
            </span>

            <span class='address-design'> => <%= r.address %></span>

            <hr>
          </div>

          <div class="center">Description: <%= r.description %></div>
          <div class='center'>Capacity: <%= r.capacity %></div>
          <% if current_user %>
            <div class='center'><%= link_to 'Edit', edit_restaurant_path(r) %> | <%= link_to 'Delete',r, method: :delete, data: { confirm: 'Are you sure?' } %></div>
          <% end %>
        </li>
      <% end %>

    </ul>
  </div>

</div>