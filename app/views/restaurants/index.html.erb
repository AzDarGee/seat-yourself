<div class='row'>
  <div class='col-md-8'>
    <ul class='list-group'>

      <% @restaurants.each do |r| %>
      	<li class='list-group-item'>
          <div><span class='title-design'><%= r.name %></span> | <span class='address-design'><%= r.address %></span></div>
          <div class="center">Description: <%= r.description %></div>
          <div class='center'>Capacity: <%= r.capacity %></div>
          <% if current_user %>
            <div class='center'><%= link_to 'Edit', edit_restaurant_path(r) %> | <%= link_to 'Delete',r, method: :delete, data: { confirm: 'Are you sure?' } %></div>
          <% end %>
        </li>
      <% end %>

    </ul>
  </div>
  <div class='col-md-4 center'>PICTURE HERE</div>
</div>