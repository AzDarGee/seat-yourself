<div class="row">
  <div class="col-md-4"></div>
  <div class="col-md-4">
  
  <div class="panel panel-default">
      <div class="panel-heading">
        <h2>Customer Sign Up</h2>
        <h4>Get your restaurant noticed! Sign up to be an owner below.</h4>
      </div>
      <div class="panel-body">

        <%= form_for @owner do |f| %>

          <%= render 'errors' %>

          <div class="field">
            <%= f.label :user_name %>
            <%= f.text_field :user_name, placeholder: "User Name", class: "form-control" %>
          </div>
          <br>
          <div class="field">
            <%= f.label :email %>
            <%= f.text_field :email, placeholder: "Email", class: "form-control" %>
          </div>
          <br>
          <div class="field">
            <%= f.label :password %>
            <%= f.password_field :password, placeholder: "Password", class: "form-control" %>
          </div>
          <br>
          <div class="field">
            <%= f.label :confirmation %>
            <%= f.password_field :password_confirmation, placeholder: "Confirm Password", class: "form-control" %>
          </div>
          <br>
          <div class="actions"><%= f.submit "Sign Up", class: "btn btn-primary" %></div>
        <% end %>

      </div> <!-- end panel body -->

      <div class="panel-footer">
        <%= link_to 'Sign Up - as a Customer', new_customer_path %>
      </div>

    </div>    

  </div>
  <div class="col-md-4"></div>
</div>

